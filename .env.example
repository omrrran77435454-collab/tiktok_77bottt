# ---------------------------------------------------------------------------
# أدوات المعلم — إعدادات Firebase للواجهة (Vite)
#
# انسخ هذا الملف إلى ‎.env‎ ثم ضع القيم من:
#   Firebase Console → Project settings → Your apps → Web app → SDK setup
#
# هذه القيم ليست أسراراً: Firebase يصمّمها لتكون علنية داخل حزمة المتصفّح.
# الحماية الحقيقية = التحقّق من توقيع ID Token في الـ Worker
#                 + قائمة النطاقات المصرّح بها في Firebase Console.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=[ضع القيمة هنا]
VITE_FIREBASE_AUTH_DOMAIN=[PROJECT_ID.firebaseapp.com]
VITE_FIREBASE_PROJECT_ID=[ضع القيمة هنا]
VITE_FIREBASE_APP_ID=[ضع القيمة هنا]
VITE_FIREBASE_MESSAGING_SENDER_ID=[ضع القيمة هنا]

# وضع اختبار E2E فقط — اتركه فارغاً أو false في الإنتاج.
VITE_E2E_TEST_MODE=false
