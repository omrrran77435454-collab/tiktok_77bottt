{
  "name": "teacher-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "أدوات المعلم - منصة عربية توفر أدوات عملية تختصر شغل المعلم",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply teacher-tools-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply teacher-tools-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint:fix": "eslint . --fix",
    "e2e:prepare": "node scripts/prepare-e2e.mjs && wrangler d1 migrations apply teacher-tools-db --local",
    "mock:telegram": "node scripts/mock-telegram.mjs 8788",
    "qa:screens": "node scripts/qa-screens.mjs",
    "qa:templates": "node scripts/qa-templates.mjs",
    "qa:print": "node scripts/qa-print.mjs",
    "qa:pages": "node scripts/qa-pages.mjs",
    "icons": "python3 scripts/generate-icons.py && node scripts/generate-og-image.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.9",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}