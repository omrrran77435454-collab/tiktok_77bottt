/**
 * إعدادات Cloudflare Worker لمنصة "أدوات المعلم".
 * وثائق: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * ملاحظة أمنية: لا تضع أي Secret داخل هذا الملف (فهو مرفوع إلى Git).
 * استخدم: wrangler secret put <NAME>
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "teacher-tools",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // الأصول الثابتة (SPA) تُقدَّم مباشرة من شبكة Cloudflare بدون استدعاء الـ Worker.
  // فقط المسارات تحت /api/* تُمرَّر إلى الـ Worker (توفير في الاستدعاءات والتكلفة).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teacher-tools-db",
      // يُملأ آلياً أثناء النشر من سكربت scripts/deploy.mjs
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // متغيّرات غير سرّية فقط. القيم السرّية عبر wrangler secret put
  "vars": {
    "E2E_TEST_MODE": "false"
  },

  "observability": {
    "enabled": true
  }
}
